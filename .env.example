# Copy to .env if you need to override the defaults.
# Set a unique secret for this installation.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
# Set to true only when the app is served over HTTPS
# COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=20
MAX_QUESTION_CHARS=1200

OLLAMA_ENABLED=true
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120

# auto = Ollama if its model is installed, otherwise a local OpenAI-compatible
# server; or force one with: ollama | openai
LLM_BACKEND=auto
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=120

# small = 0.5B (fastest), default = 1.5B, large = 3B (best but slowest)
LOCAL_AI_PRESET=default
# Port of the built-in model server (default 8080)
LOCAL_AI_PORT=8080
# Direct GGUF URL if you want a model other than the presets
# LOCAL_AI_MODEL_URL=
# Where downloaded models are stored (default: ./models)
# MODELS_DIR=
# Saved model choice file (written by the Profile page)
# MODEL_SELECTION_FILE=
# Extra folders to scan for GGUF models, separated by ; on Windows and : elsewhere
# EXTRA_MODEL_DIRS=
# DOCUQUERY_MANAGED_MODEL is set automatically by local_ai.py so the app can
# hot-swap models; do not set it by hand.
# Context window and CPU threads for the built-in server (leave blank for auto)
LOCAL_AI_CONTEXT=6144
# LOCAL_AI_THREADS=4

# Smaller values make answers arrive faster on a laptop CPU.
RAG_TOP_K=4
SUMMARY_CONTEXT_CHARS=9000
ANSWER_CONTEXT_CHARS=12000

# Answer length: brief | balanced | detailed (the chat box has a per-question switch too)
ANSWER_DETAIL=balanced
# Hard caps, 0 = use the length preset
ANSWER_MAX_TOKENS=0
SUMMARY_MAX_TOKENS=900

# Default hashing embeddings work offline without another model download.
EMBEDDING_BACKEND=hashing
LOCAL_DB_PATH=instance/demo.sqlite3
