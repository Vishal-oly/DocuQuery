# Copy this file to .env and add your own server-side values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
PORT=5000
MAX_UPLOAD_MB=20

# Groq is optional for a local demo. Without a key, the app shows an extractive preview.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: leave both blank to use local SQLite while you set up Supabase.
# For the Flask server only; never put the service-role key in frontend JavaScript.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# hashing works offline with no model download. Optional stronger semantic embeddings:
# EMBEDDING_BACKEND=sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=hashing
LOCAL_DB_PATH=instance/demo.sqlite3
RAG_TOP_K=6
SUMMARY_CONTEXT_CHARS=18000
